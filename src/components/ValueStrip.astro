  <div class="frame">
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-px bg-rule border-x border-rule">
      {valueProps.map((text) => (
        <div class="bg-canvas px-4 py-4 t-label text-ink">{text}</div>
      ))}
    </div>
  </div>
</section>
