---
import SectionHeader from './SectionHeader.astro';
import { services } from '../data/site';
---

<section id="diensten" class="border-b border-outline/25">
  <div class="frame py-10 md:py-16">
    <SectionHeader
      eyebrow="02 / Diensten"
      title="Diensten op maat"
      aside="Geen standaard sjablonen. Elk project wordt vanaf de grond opgebouwd."
      noBorder
    />

    <div class="divide-y divide-outline/25 border-t border-outline/25">
      {
        services.map((service) => (
          <article class="grid grid-cols-4 md:grid-cols-8 lg:grid-cols-12 gap-x-6 gap-y-4 py-8 md:py-10">
            <div class="col-span-4 md:col-span-8 lg:col-span-1">
              <span class="t-code text-terracotta">{service.id}</span>
            </div>

            <h3 class="col-span-4 md:col-span-8 lg:col-span-5 t-h2 text-ink max-w-[16ch]">{service.title}</h3>

            <div class="col-span-4 md:col-span-8 lg:col-span-6 space-y-4">
              <p class="t-body text-ink/75 max-w-[54ch]">{service.description}</p>
              <ul class="flex flex-wrap gap-x-6 gap-y-2">
                {service.bullets.map((bullet) => (
                  <li class="t-body-sm text-ink/70 flex items-baseline gap-2">
                    <span class="text-terracotta" aria-hidden="true">—</span>
                    <span>{bullet}</span>
                  </li>
                ))}
              </ul>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
