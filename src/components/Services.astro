---
import SectionHeader from './SectionHeader.astro';
import { services } from '../data/site';
---

<section id="diensten" class="border-b border-rule">
  <div class="frame py-10 md:py-16">
    <SectionHeader
      eyebrow="Section 02"
      title="Diensten op maat"
      aside="Geen standaard sjablonen. Elk project wordt vanaf de grond opgebouwd."
    />

    <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-rule border border-rule">
      {services.map((s) => (
        <div class:list={['flex flex-col p-6 md:p-10', s.tinted ? 'bg-canvas' : 'bg-white']}>
          <h3 class="t-h3 text-ink mb-4">{s.title}</h3>
          <p class="t-body text-steel mb-6">{s.description}</p>
          <ul class="mt-auto t-code text-steel border-t border-rule pt-4 space-y-2">
            {s.bullets.map((b) => (
              <li class="flex items-baseline gap-2"><span aria-hidden="true">→</span> {b}</li>
            ))}
          </ul>
          <span class="t-label text-steel mt-6">[ Service {s.id} ]</span>
        </div>
      ))}
    </div>
  </div>
</section>
