---
import SectionHeader from './SectionHeader.astro';
import { services } from '../data/site';
---

<section id="diensten" class="border-b border-rule">
  <div class="frame py-10 md:py-16">
    <SectionHeader
      eyebrow="Section 02"
      title="Diensten op maat"
      aside="Geen standaard sjablonen. Elk project wordt vanaf de grond opgebouwd."
    />

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 self-start">
      {services.map((s) => (
        <div class="group bg-white p-6 md:p-10 flex flex-col border border-rule transition-all duration-300 hover:-translate-y-1 hover:z-10 hover:bg-canvas relative">
          <span class="t-label text-steel/50 mb-4">Service {s.id}</span>
          <h3 class="t-h3 text-ink mb-4 transition-colors group-hover:text-vermilion">{s.title}</h3>
          <p class="t-body text-steel mb-6">{s.description}</p>
          <ul class="mt-auto t-code text-steel border-t border-rule pt-4 space-y-2">
            {s.bullets.map((b) => (
              <li class="flex items-baseline gap-2"><span aria-hidden="true">→</span> {b}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  #diensten .group:hover {
    box-shadow: 0 20px 40px -10px rgba(13, 15, 17, 0.18);
  }
</style>
