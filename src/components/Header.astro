---
import { nav } from '../data/site';
---

<header class="sticky top-0 z-50 bg-paper/95 backdrop-blur supports-[backdrop-filter]:bg-paper/80 border-b border-outline/30">
  <div class="frame flex items-center justify-between gap-4 py-4">
    <a href="#top" class="flex items-baseline gap-3 group" aria-label="Sherman Software — naar boven">
      <span class="font-serif text-xl md:text-2xl leading-none tracking-tight text-ink transition-colors group-hover:text-terracotta"
        >Sherman Software</span
      >
    </a>

    <nav class="hidden lg:flex items-center gap-7" aria-label="Hoofdnavigatie">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class="text-[0.9375rem] text-ink/75 hover:text-terracotta transition-colors"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <a href="#contact" class="btn btn-primary btn-compact hidden sm:inline-flex">Bespreek project</a>

      <button
        type="button"
        id="nav-toggle"
        class="lg:hidden inline-flex h-11 w-11 items-center justify-center border border-outline/50 rounded-brand text-ink hover:bg-espresso hover:text-paper hover:border-espresso transition-colors"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="Menu openen"
      >
        <svg width="18" height="14" viewBox="0 0 18 14" fill="none" aria-hidden="true">
          <path d="M0 1H18M0 7H18M0 13H18" stroke="currentColor" stroke-width="1.5" />
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-nav" hidden class="lg:hidden border-t border-outline/30 bg-paper">
    <nav class="frame flex flex-col py-2" aria-label="Mobiele navigatie">
      {
        nav.map((item) => (
          <a href={item.href} class="t-h3 text-ink py-3 border-b border-outline/20 hover:text-terracotta">
            {item.label}
          </a>
        ))
      }
      <a href="#contact" class="btn btn-primary btn-block my-4">Bespreek project</a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('mobile-nav');

  const setOpen = (open: boolean) => {
    if (!toggle || !menu) return;
    menu.hidden = !open;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Menu sluiten' : 'Menu openen');
  };

  toggle?.addEventListener('click', () => {
    setOpen(menu?.hidden ?? false);
  });

  menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setOpen(false)));

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') setOpen(false);
  });

  // Reset to closed when returning to the desktop breakpoint.
  const desktop = window.matchMedia('(min-width: 75rem)');
  desktop.addEventListener('change', (event) => {
    if (event.matches) setOpen(false);
  });
</script>
