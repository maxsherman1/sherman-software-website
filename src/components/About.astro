---
import SectionHeader from './SectionHeader.astro';
import { aboutCards } from '../data/site';
---

<section id="over" class="border-b border-outline/25">
  <div class="frame py-10 md:py-16">
    <SectionHeader
      eyebrow="03 / Over de studio"
      title="Persoonlijk, duidelijk & betrouwbaar"
      noBorder
    />
    <div class="grid grid-cols-4 md:grid-cols-8 lg:grid-cols-12 gap-x-6 gap-y-10">
      <div class="col-span-4 md:col-span-8 lg:col-span-5 space-y-4">
        <figure class="border-l-2 border-terracotta pl-6 space-y-4 mt-10">
          <blockquote class="t-h2 italic font-normal text-ink text-balance">
            “Als zelfstandig ontwikkelaar combineer ik de technische precisie van een bureau met de snelheid en het
            persoonlijke contact van een directe partner.”
          </blockquote>
          <figcaption class="t-label text-outline">— Sherman Software</figcaption>
        </figure>
      </div>

      <div class="col-span-4 md:col-span-8 lg:col-span-7 space-y-10">
        <dl class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-8 border-t border-outline/25 pt-8">
          {
            aboutCards.map((card) => (
              <div class="space-y-2">
                <dt class="t-h3 text-ink">{card.title}</dt>
                <dd class="t-body-sm text-ink/70">{card.text}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </div>
</section>