---
import { aboutCards } from '../data/site';
---

<section id="over" class="border-b border-rule">
  <div class="frame grid grid-cols-4 md:grid-cols-8 lg:grid-cols-12 gap-x-4 md:gap-x-6 gap-y-10 py-10 md:py-16">
    <!-- Editorial quote -->
    <div class="col-span-4 md:col-span-8 lg:col-span-5 space-y-6">
      <span class="t-label text-steel block">Section 03 — Over studio</span>
      <h2 class="t-h1 text-ink">Persoonlijk, duidelijk &amp; betrouwbaar</h2>
      <blockquote class="reg border border-rule bg-white p-6 space-y-4">
        <p class="t-h3 italic font-normal text-ink">
          "Als zelfstandig ontwikkelaar combineer ik de technische precisie van een bureau met de snelheid en het persoonlijke contact van een directe partner."
        </p>
        <footer class="t-label text-steel">— Sherman Software</footer>
      </blockquote>
    </div>

    <!-- 4-point grid -->
    <div class="col-span-4 md:col-span-8 lg:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-px bg-rule border border-rule self-start">
      {aboutCards.map((c) => (
        <div class="bg-white p-6 flex flex-col">
          <h4 class="t-h3 text-ink mb-2">{c.title}</h4>
          <p class="t-body text-steel mb-6">{c.text}</p>
          <span class="t-label text-steel mt-auto">{c.tag}</span>
        </div>
      ))}
    </div>
  </div>
</section>
