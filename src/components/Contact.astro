---
import { contact, projectTypes } from '../data/site';

const rows = [
  { label: 'E-mail', value: contact.email, href: `mailto:${contact.email}` },
  { label: 'Locatie', value: contact.location },
  { label: 'Reactietijd', value: contact.response },
];
---

<section id="contact" class="bg-ink">
  <div class="frame grid grid-cols-4 md:grid-cols-8 lg:grid-cols-12 gap-x-4 md:gap-x-6 gap-y-10 py-10 md:py-16">
    <!-- Direct contact info -->
    <div class="col-span-4 md:col-span-8 lg:col-span-5 space-y-6">
      <span class="t-label text-canvas/60 block">Section 06 — Contact</span>
      <h2 class="t-h1 text-vermilion">Klaar om jouw project te starten?</h2>
      <p class="t-body text-canvas/60">
        Vul het formulier in of stuur direct een e-mail. Je ontvangt binnen 24 uur een inhoudelijke reactie en prijsindicatie.
      </p>

      <!-- Recessed telemetry readout -->
      <dl class="bg-ink border border-vermilion text-canvas p-4">
        {rows.map((r) => (
          <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1 sm:gap-4 py-3 border-b border-canvas/25 last:border-b-0">
            <dt class="t-label text-canvas/60">{r.label}</dt>
            <dd class="t-code">
              {r.href ? <a href={r.href} class="hover:text-vermilion">{r.value}</a> : r.value}
            </dd>
          </div>
        ))}
      </dl>
    </div>

    <!-- Form -->
    <div class="col-span-4 md:col-span-8 lg:col-span-7">
      <form id="contact-form" class="border border-rule bg-white p-6 md:p-10 space-y-6">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="naam" class="t-label text-steel block mb-2">Naam *</label>
            <input id="naam" name="naam" type="text" required placeholder="Jan de Vries" class="field" />
          </div>
          <div>
            <label for="email" class="t-label text-steel block mb-2">E-mailadres *</label>
            <input id="email" name="email" type="email" required placeholder="jan@bedrijf.nl" class="field" />
          </div>
        </div>

        <div>
          <label for="type" class="t-label text-steel block mb-2">Type project</label>
          <select id="type" name="type" class="field">
            {projectTypes.map((t) => <option>{t}</option>)}
          </select>
        </div>

        <div>
          <label for="omschrijving" class="t-label text-steel block mb-2">Project omschrijving</label>
          <textarea
            id="omschrijving"
            name="omschrijving"
            rows="4"
            placeholder="Vertel kort over je doelen, wensen en eventuele gewenste opleverdatum..."
            class="field"
          ></textarea>
        </div>

        <button type="submit" class="btn btn-primary w-full justify-center">Verstuur aanvraag</button>
      </form>
    </div>
  </div>
</section>

<script>
  // Placeholder behaviour carried over from the prototype: nothing is sent yet.
  document.querySelector<HTMLFormElement>('#contact-form')?.addEventListener('submit', (e) => {
    e.preventDefault();
    alert('Bedankt voor je aanvraag! Er wordt snel contact met je opgenomen.');
  });
</script>
