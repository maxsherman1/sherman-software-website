---
import SectionHeader from './SectionHeader.astro';
import { pricing } from '../data/site';
---

<section id="tarieven" class="border-b border-outline/25">
  <div class="frame py-10 md:py-16">
    <SectionHeader
      eyebrow="05 / Investeringen"
      title="Indicatieve tarieven"
      aside="Geen onduidelijkheid. Elke offerte wordt op maat uitgeschreven met heldere scope en vaste prijsafspraak."
      noBorder
    />

    <div class="grid grid-cols-1 md:grid-cols-3 border-t border-outline/25">
      {
        pricing.map((tier) => (
          <article
            class:list={[
              'flex flex-col gap-4 py-8 md:py-10 md:px-8 border-b border-outline/25 md:border-b-0 md:border-r',
              'md:first:pl-0 md:last:border-r-0 md:last:pr-0',
              tier.highlighted && 'bg-white border-t-2 border-t-terracotta',
            ]}
          >
            <div class="flex items-center justify-between gap-4">
              <span class="t-label text-outline">{tier.label}</span>
              {tier.highlighted && <span class="chip">Meest gekozen</span>}
            </div>

            <p class="t-h2 text-ink">
              {tier.price}{tier.unit && <span class="t-body-sm text-outline"> {tier.unit}</span>}
            </p>

            <p class="t-body-sm text-ink/70 flex-1">{tier.text}</p>

            <a
              href="#contact"
              class:list={['btn btn-block', tier.highlighted ? 'btn-primary' : 'btn-outline']}
            >
              Aanvragen
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>
