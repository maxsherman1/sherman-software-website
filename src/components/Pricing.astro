---
import SectionHeader from './SectionHeader.astro';
import { pricing } from '../data/site';
---

<section id="tarieven" class="border-b border-rule">
  <div class="frame py-10 md:py-16">
    <SectionHeader
      eyebrow="Section 05 — Investeringen"
      title="Indicatieve tarieven"
      aside="Geen onduidelijkheid. Elke offerte wordt op maat uitgeschreven met heldere scope en vaste prijsafspraak."
    />

    <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-rule border border-rule">
      {pricing.map((tier) => (
        <div class:list={['flex flex-col p-6 md:p-10', tier.highlighted ? 'bg-ink text-canvas' : 'bg-white text-ink']}>
          <div class="flex items-start justify-between gap-4 mb-4">
            <span class:list={['t-label', tier.highlighted ? 'text-canvas/60' : 'text-steel']}>{tier.label}</span>
            {tier.highlighted && <span class="chip chip-signal text-canvas border-canvas/25 shrink-0">Meest gekozen</span>}
          </div>
          <div class="t-h2 tabular-nums mb-4">
            {tier.price}
            {tier.unit && <span class="t-code text-steel"> {tier.unit}</span>}
          </div>
          <p class:list={['t-body mb-6', tier.highlighted ? 'text-canvas/80' : 'text-steel']}>{tier.text}</p>
          <a
            href="#contact"
            class:list={['btn w-full justify-center mt-auto', tier.highlighted ? 'btn-inverse' : 'btn-outline']}
          >
            Aanvragen
          </a>
        </div>
      ))}
    </div>
  </div>
</section>
