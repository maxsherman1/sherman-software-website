---
import SectionHeader from './SectionHeader.astro';
import { pricing } from '../data/site';
---

<section id="tarieven" class="border-b border-rule overflow-visible">
  <div class="frame py-10 md:py-16" style="overflow: visible;">
    <SectionHeader
      eyebrow="Section 05 — Investeringen"
      title="Indicatieve tarieven"
      aside="Geen onduidelijkheid. Elke offerte wordt op maat uitgeschreven met heldere scope en vaste prijsafspraak."
    />

    <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-rule border border-rule relative z-10" style="overflow: visible;">
      {pricing.map((tier) => (
        tier.highlighted ? (
          <div class="flex flex-col p-6 md:p-10 bg-ink text-canvas h-full">
            <div class="flex items-start justify-between gap-4 mb-4">
              <span class="t-label text-canvas/60">{tier.label}</span>
            </div>
            <div class="t-h2 tabular-nums mb-4">
              {tier.price}
              {tier.unit && <span class="t-code text-steel"> {tier.unit}</span>}
            </div>
            <p class="t-body text-canvas/80 mb-6">{tier.text}</p>
            <a href="#contact" class="btn btn-inverse w-full justify-center mt-auto">Aanvragen</a>
          </div>
        ) : (
          <div class="flex flex-col p-6 md:p-10 bg-white text-ink">
            <div class="flex items-start justify-between gap-4 mb-4">
              <span class="t-label text-steel">{tier.label}</span>
            </div>
            <div class="t-h2 tabular-nums mb-4">
              {tier.price}
              {tier.unit && <span class="t-code text-steel"> {tier.unit}</span>}
            </div>
            <p class="t-body text-steel mb-6">{tier.text}</p>
            <a href="#contact" class="btn btn-outline w-full justify-center mt-auto">Aanvragen</a>
          </div>
        )
      ))}
    </div>
  </div>
</section>

<style>
  #tarieven, #tarieven .frame, #tarieven .grid, #tarieven .grid > div {
    overflow: visible !important;
  }
</style>
