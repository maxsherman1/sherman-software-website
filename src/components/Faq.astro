---
import SectionHeader from './SectionHeader.astro';
import { faq } from '../data/site';
---

<section class="border-b border-outline/25">
  <div class="frame py-10 md:py-16">
    <SectionHeader
      eyebrow="06 / Vragen"
      title="Veelgestelde vragen"
      noBorder
    />

    <div class="divide-y divide-outline/25 border-t border-outline/25">
      {
        faq.map((item) => (
          <details class="faq-item group py-5">
            <summary class="flex items-start justify-between gap-6 cursor-pointer">
              <h3 class="t-h3 text-ink group-hover:text-terracotta transition-colors">{item.q}</h3>
              <span
                class="faq-mark t-h3 text-terracotta shrink-0 leading-none"
                aria-hidden="true"
              >
                +
              </span>
            </summary>
            <p class="t-body text-ink/75 pt-4 max-w-[64ch]">{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>