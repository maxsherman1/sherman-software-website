---
import SectionHeader from './SectionHeader.astro';
import { steps } from '../data/site';
---

<section class="border-b border-outline/25">
  <div class="frame py-10 md:py-16">
    <SectionHeader
      eyebrow="04 / Aanpak"
      title="Van idee tot livegang"
      aside="Een rustig, voorspelbaar proces in vier stappen, met korte lijnen en duidelijke afspraken."
      noBorder
    />

    <ol class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-10">
      {
        steps.map((step) => (
          <li class="border-t border-ink pt-5 space-y-3">
            <span class="t-label text-terracotta">Stap {step.id}</span>
            <h3 class="t-h3 text-ink">{step.title}</h3>
            <p class="t-body-sm text-ink/70">{step.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
