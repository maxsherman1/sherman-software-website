---
import SectionHeader from './SectionHeader.astro';
import { steps } from '../data/site';
---

<section class="border-b border-rule">
  <div class="frame py-10 md:py-16">
    <SectionHeader
      eyebrow="Section 04"
      title="4-stappen aanpak"
      aside="Een gestroomlijnd proces van idee tot livegang."
    />

    <div class="process-grid grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 self-start">
      {steps.map((s) => (
        <div class="group bg-white p-6 flex flex-col border border-rule transition-all duration-300 hover:-translate-y-1 hover:z-10 hover:bg-canvas relative">
          <h3 class="t-h3 text-ink mb-2 transition-colors group-hover:text-vermilion">{s.title}</h3>
          <p class="t-body text-steel">{s.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .process-grid .group:hover {
    box-shadow: 0 20px 40px -10px rgba(13, 15, 17, 0.18);
  }
</style>
