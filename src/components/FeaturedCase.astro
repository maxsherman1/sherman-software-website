---
import SectionHeader from './SectionHeader.astro';
import { caseSpecs } from '../data/site';
---

<section id="werk" class="border-b border-rule">
  <div class="frame py-10 md:py-16">
    <SectionHeader
      eyebrow="Section 01"
      title="Uitgelicht portfolio project"
      aside="Case study: custom webapplicatie dashboard voor de financiële sector."
    />

    <div class="reg border border-rule bg-white grid grid-cols-1 lg:grid-cols-12">
      <!-- Info -->
      <div class="lg:col-span-5 p-6 md:p-10 flex flex-col gap-6 border-b lg:border-b-0 lg:border-r border-rule">
        <div><span class="chip text-steel">Webapplicatie op maat</span></div>

        <h3 class="t-h2 text-ink">Investment Health Checks</h3>

        <p class="t-body text-steel">
          Een overzichtelijk, krachtig analyseplatform ontworpen voor het beoordelen van investeringsportfolio's. Ontwikkeld voor maximale verwerkingssnelheid, heldere datavisualisaties en mobiele toegankelijkheid.
        </p>

        <dl class="mt-auto border-t border-rule">
          {caseSpecs.map((spec) => (
            <div class="flex items-baseline justify-between gap-4 py-2 border-b border-rule t-code">
              <dt class="text-steel">{spec.label}</dt>
              <dd class="text-ink text-right">{spec.value}</dd>
            </div>
          ))}
        </dl>
      </div>

      <!-- Live iframe preview (desktop scaled) -->
      <div class="lg:col-span-7 p-4 md:p-6 flex">
        <div id="preview-wrapper" class="w-full border border-rule overflow-hidden bg-[#ececec] rounded-lg shadow-lg">
          <!-- Mac-style browser chrome -->
          <div class="flex items-center gap-3 px-3 py-2 bg-[#f5f5f5] border-b border-[#d1d1d1] select-none">
            <div class="flex items-center gap-2">
              <span class="w-3 h-3 rounded-full bg-[#ff5f57] ring-1 ring-[#e0443e]/30"></span>
              <span class="w-3 h-3 rounded-full bg-[#febc2e] ring-1 ring-[#d4a017]/30"></span>
              <span class="w-3 h-3 rounded-full bg-[#28c840] ring-1 ring-[#1aab29]/30"></span>
            </div>
            <div class="flex-1 min-w-0">
              <div class="bg-white rounded border border-[#d1d1d1] px-2 py-1 text-xs text-center text-[#555] font-mono truncate shadow-sm">
                investmenthealthchecks.com
              </div>
            </div>
            <span class="text-[10px] uppercase tracking-wide text-[#888] font-medium shrink-0">Live preview</span>
          </div>
          <div id="preview-scaler" style="width: 1440px; transform-origin: top left; background:#0d0f11;">
            <iframe
              src="https://investmenthealthchecks.com"
              width="1440"
              height="900"
              style="border:0; display:block;"
              loading="lazy"
              title="Investment Health Checks live website"
              sandbox="allow-scripts allow-same-origin allow-forms"
            ></iframe>
          </div>
        </div>
        <script is:inline>
          (function () {
            const wrapper = document.getElementById('preview-wrapper');
            const scaler = document.getElementById('preview-scaler');
            const DESKTOP_W = 1440;
            const DESKTOP_H = 900;
            function resize() {
              if (!wrapper || !scaler) return;
              const scale = wrapper.clientWidth / DESKTOP_W;
              scaler.style.transform = 'scale(' + scale + ')';
              wrapper.style.height = Math.round(DESKTOP_H * scale) + 'px';
            }
            resize();
            window.addEventListener('resize', resize);
          })();
        </script>
      </div>
    </div>
  </div>
</section>

