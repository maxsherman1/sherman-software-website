---
import SectionHeader from './SectionHeader.astro';

const focus = [
  'Een online aanvraagproces voor klanten',
  'Aparte omgevingen voor klanten en beheerders',
  'Documentuploads en gegevensopslag',
  'Een offerte- en betalingsproces',
  'Een technische basis voor verdere uitbreiding',
];
---

<section id="werk" class="border-b border-outline/25">
  <div class="frame py-10 md:py-16">
    <SectionHeader
      eyebrow="01 / Werk"
      title="Uitgelicht project"
      aside="Een live webapplicatie voor het aanvraag- en beoordelingsproces van Investment Health Checks."
      noBorder
    />

    <div class="grid grid-cols-1 lg:grid-cols-12 border border-outline/30 rounded-brand overflow-hidden bg-white">
      <!-- Info -->
      <div class="lg:col-span-5 p-6 md:p-10 flex flex-col gap-5 border-b lg:border-b-0 lg:border-r border-outline/30">
        <div><span class="chip">Webapplicatie op maat</span></div>

        <h3 class="t-h2 text-ink">Investment Health Checks</h3>

        <p class="t-body text-ink/75">
          Voor Investment Health Checks ontwikkelde ik een webapplicatie die klanten en beheerders ondersteunt
          tijdens het aanvraag- en beoordelingsproces.
        </p>
        <p class="t-body text-ink/75">
          Klanten leveren online hun gegevens aan en uploaden documenten. Beheerders beoordelen aanvragen,
          vragen aanvullende informatie op en handelen het proces verder af vanuit een afgeschermde omgeving.
        </p>

        <ul class="space-y-2">
          {
            focus.map((item) => (
              <li class="t-body-sm text-ink/75 flex items-baseline gap-2">
                <span class="text-terracotta" aria-hidden="true">—</span>
                <span>{item}</span>
              </li>
            ))
          }
        </ul>

        <dl class="mt-auto pt-5 border-t border-outline/25">
          <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 sm:gap-4 t-code">
            <dt class="text-outline shrink-0">Gebruikte technologie</dt>
            <dd class="text-ink">Next.js / React / TypeScript / PostgreSQL / Vercel</dd>
          </div>
        </dl>

        <a
          href="https://investmenthealthchecks.com"
          target="_blank"
          rel="noopener"
          class="btn btn-primary btn-block"
        >
          Bekijk live platform <span aria-hidden="true">→</span>
        </a>
      </div>

      <!-- Live scaled preview -->
      <div class="lg:col-span-7 p-4 md:p-6 flex bg-paper">
        <div
          id="preview-wrapper"
          class="w-full border border-outline/40 rounded-brand overflow-hidden bg-white relative lg:h-full"
        >
          <div
            id="preview-chrome"
            class="flex items-center gap-3 px-3 py-2 bg-paper border-b border-outline/30 select-none relative z-10"
          >
            <div class="flex items-center gap-2">
              <span class="w-3 h-3 rounded-full bg-[#ff5f57] ring-1 ring-[#e0443e]/30"></span>
              <span class="w-3 h-3 rounded-full bg-[#febc2e] ring-1 ring-[#d4a017]/30"></span>
              <span class="w-3 h-3 rounded-full bg-[#28c840] ring-1 ring-[#1aab29]/30"></span>
            </div>
            <div class="flex-1 min-w-0">
              <div class="bg-white rounded border border-[#d1d1d1] px-2 py-1 text-xs text-center text-[#555] font-mono truncate shadow-sm">
                investmenthealthchecks.com
              </div>
            </div>
            <span class="text-[10px] uppercase tracking-wide text-[#888] font-medium shrink-0">Live preview</span>
          </div>
          <div id="preview-scaler" class="absolute left-0" style="transform-origin:top left;">
            <iframe
              id="preview-iframe"
              src="https://investmenthealthchecks.com"
              style="border:0; display:block;"
              loading="lazy"
              title="Investment Health Checks live website"
              sandbox="allow-scripts allow-same-origin allow-forms"></iframe>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    var wrapper = document.getElementById('preview-wrapper');
    var scaler = document.getElementById('preview-scaler');
    var iframe = document.getElementById('preview-iframe');
    var chrome = document.getElementById('preview-chrome');
    function resize() {
      if (!wrapper || !scaler || !iframe || !chrome) return;
      var vw = window.innerWidth;
      if (vw > 1440) vw = 1440;
      var scale = wrapper.clientWidth / vw;
      var chromeH = chrome.offsetHeight || 40;
      var isLarge = window.innerWidth >= 1024;
      var targetH;
      if (isLarge) {
        wrapper.style.height = '';
        targetH = wrapper.clientHeight - chromeH;
        if (targetH < 300) targetH = 300;
      } else {
        targetH = 400;
        wrapper.style.height = chromeH + targetH + 'px';
      }
      var vh = Math.round(targetH / scale);
      iframe.width = vw;
      iframe.height = vh;
      scaler.style.width = vw + 'px';
      scaler.style.height = vh + 'px';
      scaler.style.transform = 'scale(' + scale + ')';
      scaler.style.top = chromeH + 'px';
    }
    resize();
    window.addEventListener('resize', resize);
  })();
</script>
